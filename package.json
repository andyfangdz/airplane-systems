{
  "name": "airplane-systems",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Interactive 3D study models of airplane systems (POH/AFM Section 7): Cirrus SR20 G6 and SR22T G6, Cessna 172S and 182T NAV III, Diamond DA40, Mooney M20C Ranger. Built with Next.js and React Three Fiber.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run geometry:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui:m20c": "node scripts/test-m20c-ui.mjs",
    "test:ui:fleet": "node scripts/test-fleet-ui.mjs",
    "test:ui:load": "node scripts/test-load-ui.mjs",
    "test:ui:walkaround": "node scripts/test-walkaround-ui.mjs",
    "test:ui:sr20": "node scripts/test-sr20-walkaround-ui.mjs",
    "test:ui:depth": "node scripts/test-fleet-depth-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run check:compiler && npm test && npm run test:react && npm run test:trusted-preview",
    "shot": "node scripts/shot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:deploy": "vitest run --config vitest.deploy.config.mts",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "trace": "node scripts/trace-airframes.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:trusted-preview": "node --test .github/trusted-preview/controller.test.mjs",
    "geometry:build": "node scripts/build-geometry.mjs",
    "test:ui:geometry": "node scripts/test-geometry-ui.mjs",
    "geometry:stats": "node scripts/geometry-stats.mjs",
    "test:ui:doors": "node scripts/test-door-mechanisms-ui.mjs",
    "check:compiler": "node scripts/check-react-compiler.mjs",
    "test:react": "vitest run --config vitest.react.config.mts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "@vercel/analytics": "^2.0.1",
    "cdt2d": "1.0.0",
    "meshoptimizer": "1.1.1",
    "next": "16.3.8",
    "polygon-clipping": "0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@types/babel__core": "7.20.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.9",
    "three-mesh-bvh": "0.8.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
